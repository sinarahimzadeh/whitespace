# Copy this file to .env and enter your key there.
REVIEW_PROVIDER=openai
REVIEW_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Optional OpenAI setting. The default gpt-5.4-mini uses medium reasoning.
# For other models, set this only if that model supports reasoning effort.
# REVIEW_REASONING_EFFORT=medium

# To use Anthropic instead, set REVIEW_PROVIDER=anthropic,
# REVIEW_MODEL=claude-sonnet-4-6 and enter an Anthropic key below.
ANTHROPIC_API_KEY=
